---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectoryHeader from '../../components/DirectoryHeader.astro';
import organizationsData from '../../data/organizations.json';
import { buildTaxonomyHubs, buildYearHubs } from '../../lib/hubs';
import type { Organization } from '../../types';

const organizations = organizationsData as Organization[];
const latestYear = buildYearHubs(organizations)[0].year;
const startingTechnologies = buildTaxonomyHubs(
  organizations,
  'technology',
).filter((hub) => ['python', 'javascript', 'cpp'].includes(hub.slug));

const title = 'How to Choose a GSoC Organization | GSoC Organizations';
const description =
  'A practical guide to choosing a Google Summer of Code organization using technology fit, participation history, completed projects, repositories, and community activity.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const breadcrumbs = [
  { name: 'Organizations', href: '/' },
  { name: 'How to choose a GSoC organization', href: Astro.url.pathname },
];
const faqs = [
  {
    question: 'Which GSoC organization is best for a beginner?',
    answer:
      'There is no single best organization. A strong choice matches skills you can already demonstrate, maintains clear contribution guidance, has active communication, and offers work you want to continue after the application period.',
  },
  {
    question: 'Should I choose a first-time GSoC organization?',
    answer:
      'A first-time organization can be a good fit, but it has less GSoC history to inspect. Compare its repository activity, contributor documentation, issue quality, and mentor communication instead of treating program history as the only signal.',
  },
  {
    question:
      'Does past GSoC participation guarantee an organization will return?',
    answer:
      'No. Participation history provides research context, not a prediction. Only the official Google Summer of Code website confirms organizations for a current program year.',
  },
  {
    question: 'How many organizations should I research?',
    answer:
      'Start with several candidates, then narrow the list to two or three communities after reading their repositories, contribution guidance, communication channels, and completed project records.',
  },
];

const structuredData = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((breadcrumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: breadcrumb.name,
      item: new URL(breadcrumb.href, Astro.site).href,
    })),
  },
  {
    '@type': 'Article',
    '@id': `${canonicalUrl.href}#article`,
    headline: 'How to choose a GSoC organization',
    description,
    mainEntityOfPage: canonicalUrl.href,
    author: {
      '@type': 'Person',
      name: 'Rohan Malhotra',
      url: 'https://github.com/rohanmalhotracodes',
    },
    publisher: {
      '@type': 'Organization',
      name: 'GSoC Organizations',
      url: new URL('/', Astro.site).href,
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <main class="hub-page">
    <DirectoryHeader />
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Organizations</a><span aria-hidden="true">/</span><span
        aria-current="page">How to choose a GSoC organization</span
      >
    </nav>

    <div class="page-intro">
      <span class="eyebrow">Practical research guide</span>
      <h1>How to choose a GSoC organization</h1>
      <p>
        Shortlist GSoC orgs whose technologies match skills you can already
        demonstrate, then verify repository activity, contribution guidance,
        community responsiveness, and project work you want to pursue.
      </p>
      <p class="guide-byline">
        By <a href="https://github.com/rohanmalhotracodes">Rohan Malhotra</a>,
        creator of GSoC Organizations.
      </p>
    </div>

    <div class="prose-grid">
      <article class="detail-card prose-card">
        <h2>1. Begin with technology fit</h2>
        <p>
          Use the <a href="/technologies/">technology directory</a> to find communities
          that use languages and tools you know. A familiar stack makes it easier
          to understand the codebase and submit a meaningful first contribution.
        </p>
      </article>

      <article class="detail-card prose-card">
        <h2>2. Shortlist several communities</h2>
        <p>
          Save a small group from the <a href="/">organization directory</a>
          before choosing one. Compare their focus areas through the <a
            href="/topics/">topic</a
          > and <a href="/categories/">category</a> indexes instead of relying only
          on name recognition.
        </p>
      </article>

      <article class="detail-card prose-card">
        <h2>3. Read the participation history</h2>
        <p>
          Organization profiles show archived program years and completed
          projects. Use that history to understand the kinds of work a community
          has mentored, but do not treat past participation as a guarantee of
          selection in a future year.
        </p>
      </article>

      <article class="detail-card prose-card">
        <h2>4. Inspect the repository</h2>
        <p>
          Look for recent development, a contribution guide, reproducible setup
          instructions, well-scoped issues, and respectful review discussions.
          Confirm important details on the organization’s own website and source
          repository.
        </p>
      </article>

      <article class="detail-card prose-card">
        <h2>5. Study completed projects</h2>
        <p>
          Open several historical project records from different years. Notice
          their scope, expected technical depth, final code submissions, and how
          closely each project relates to the organization’s ongoing work.
        </p>
      </article>

      <article class="detail-card prose-card">
        <h2>6. Contact the community thoughtfully</h2>
        <p>
          Read the documentation before asking questions. Introduce yourself
          briefly, describe what you have already tried, and ask a specific
          question that shows you explored the codebase. Follow each community’s
          preferred communication channel and norms.
        </p>
      </article>
    </div>

    <section class="detail-card prose-card guide-checklist">
      <h2>Final shortlist checklist</h2>
      <ul>
        <li>I can explain why the organization’s work interests me.</li>
        <li>I can build or run at least part of its codebase locally.</li>
        <li>I found contribution instructions and an active repository.</li>
        <li>
          I reviewed completed projects and understand their typical scope.
        </li>
        <li>
          I know where the community communicates and how to ask for help.
        </li>
        <li>
          I verified current-year information on the official GSoC website.
        </li>
      </ul>
      <p>
        Ready to research? <a href="/">Browse all organizations</a>, explore
        <a href={`/year/${latestYear}/`}
          >the latest archived program year ({latestYear})</a
        >, or check the
        <a
          href="https://summerofcode.withgoogle.com/"
          target="_blank"
          rel="noreferrer">official Google Summer of Code website</a
        > for current program information.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="guide-start-heading">
      <div class="hub-section-heading">
        <h2 id="guide-start-heading">Try this with the directory</h2>
      </div>
      <p>
        Choose a technology you know, open a few organization profiles, and
        compare their historical projects. These counts cover all years in this
        archive; verify the current organization list before preparing a GSoC
        proposal.
      </p>
      <div class="hub-link-grid">
        {
          startingTechnologies.map((hub) => (
            <a href={`/technology/${hub.slug}/`}>
              <>
                <strong>{hub.label}</strong>
                <span>{hub.organizationCount} organizations to explore</span>
              </>
            </a>
          ))
        }
      </div>
      <p>
        Use the <a href="/insights/">archive statistics</a> to understand participation
        patterns. More projects or years of participation do not make an organization
        easier to get into. Save candidates with the bookmark button, then return
        to
        <a href="/shortlist/">your saved organizations</a> as you research.
      </p>
    </section>

    <section class="guide-faq" aria-labelledby="guide-faq-heading">
      <div class="section-heading">
        <h2 id="guide-faq-heading">Frequently asked questions</h2>
      </div>
      <div class="prose-grid">
        {
          faqs.map((faq) => (
            <article class="detail-card prose-card">
              <h2>{faq.question}</h2>
              <p>{faq.answer}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="hub-section" aria-labelledby="guide-sources-heading">
      <div class="hub-section-heading">
        <h2 id="guide-sources-heading">Official guidance and data sources</h2>
      </div>
      <p>
        This guide explains how to use our directory for research. For program
        requirements and mentor expectations, consult Google’s contributor
        guides and each organization’s current project ideas page.
      </p>
      <ul>
        <li>
          <a
            href="https://google.github.io/gsocguides/student/choosing-an-organization"
            >Google’s guide to choosing an organization</a
          >
        </li>
        <li>
          <a
            href="https://google.github.io/gsocguides/student/finding-the-right-project"
            >Google’s guide to finding the right project</a
          >
        </li>
        <li>
          <a href="https://summerofcode.withgoogle.com/"
            >Official GSoC program website</a
          >
        </li>
        <li><a href="/about/">How this directory sources its records</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
