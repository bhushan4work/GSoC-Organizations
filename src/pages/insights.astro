---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryHeader from '../components/DirectoryHeader.astro';
import organizationsData from '../data/organizations.json';
import { buildArchiveInsights } from '../lib/archive-insights';
import type { Organization } from '../types';

const insights = buildArchiveInsights(organizationsData as Organization[]);
const latest = insights.years[0];
const title = 'GSoC Organization Statistics: Participation & Technologies';
const description = `Compare ${insights.organizationCount} GSoC organizations across ${insights.oldestYear}–${insights.latestYear}: annual participation, first appearances, project totals, and commonly listed technologies.`;
const structuredData = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Organizations',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Archive statistics',
      item: new URL('/insights/', Astro.site).href,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
>
  <main class="hub-page insights-page">
    <DirectoryHeader />
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Organizations</a><span aria-hidden="true">/</span>
      <span aria-current="page">Archive statistics</span>
    </nav>
    <section class="hub-hero" aria-labelledby="insights-heading">
      <div class="hub-hero-copy">
        <h1 id="insights-heading">GSoC organization statistics</h1>
        <p>
          This archive covers {insights.organizationCount} distinct Google Summer
          of Code organizations across {insights.years.length} program years, from
          {insights.oldestYear} to {insights.latestYear}. Of these, {
            insights.repeatOrganizationCount
          } appear in more than one year.
        </p>
        <p>
          Use the comparisons below to research communities, then
          <a href="/guides/choose-a-gsoc-organization/"
            >build a shortlist of GSoC orgs</a
          >
          whose work interests you. Participation counts do not measure acceptance
          chances.
        </p>
      </div>
      <dl class="hub-stats">
        <div>
          <dt>Distinct organizations</dt><dd>
            {insights.organizationCount.toLocaleString('en-US')}
          </dd>
        </div>
        <div>
          <dt>Archived project total</dt><dd>
            {insights.projectCount.toLocaleString('en-US')}
          </dd>
        </div>
        <div>
          <dt>Program years covered</dt><dd>{insights.years.length}</dd>
        </div>
      </dl>
    </section>

    <section class="hub-section" aria-labelledby="year-comparison-heading">
      <div class="hub-section-heading">
        <h2 id="year-comparison-heading">How participation changes by year</h2>
      </div>
      <p>
        In {latest.year}, the archive lists {latest.organizationCount} organizations
        and {latest.projectCount.toLocaleString('en-US')} projects.
        {
          latest.returningCount !== null && (
            <>
              Of those organizations, {latest.returningCount} appear in an
              earlier snapshot and {latest.firstSeenCount} appear for the first
              time within this archive.
            </>
          )
        }
      </p>
      <div
        class="insights-table-scroll"
        role="region"
        aria-label="Participation statistics table"
        tabindex="0"
      >
        <table class="insights-table">
          <caption
            >Organization and project totals, {insights.oldestYear}–{
              insights.latestYear
            }</caption
          >
          <thead
            ><tr>
              <th scope="col">Program year</th><th scope="col">Organizations</th
              >
              <th scope="col">Seen in earlier years</th><th scope="col"
                >First seen in archive</th
              >
              <th scope="col">Project total</th>
            </tr></thead
          >
          <tbody
            >{
              insights.years.map((year) => (
                <tr>
                  <th scope="row">
                    <a href={`/year/${year.year}/`}>{year.year}</a>
                  </th>
                  <td>{year.organizationCount.toLocaleString('en-US')}</td>
                  <td>
                    {year.returningCount === null
                      ? '—'
                      : year.returningCount.toLocaleString('en-US')}
                  </td>
                  <td>
                    {year.firstSeenCount === null
                      ? '—'
                      : year.firstSeenCount.toLocaleString('en-US')}
                  </td>
                  <td>{year.projectCount.toLocaleString('en-US')}</td>
                </tr>
              ))
            }</tbody
          >
        </table>
      </div>
      <p class="insights-note">
        “First seen” means no earlier appearance in our {insights.oldestYear}–{
          insights.latestYear
        }
        snapshots; an organization may have participated before our coverage begins.
        A returning organization may have skipped intervening years. Dashes mark the
        earliest year, where this archive cannot establish a prior history.
      </p>
    </section>

    <section
      class="hub-section"
      aria-labelledby="technology-comparison-heading"
    >
      <div class="hub-section-heading">
        <h2 id="technology-comparison-heading">Commonly listed technologies</h2>
      </div>
      <p>
        These are the eight most frequently listed technology tags across
        organization profiles. Each count represents distinct organizations, not
        projects or available places.
      </p>
      <div class="hub-link-grid">
        {
          insights.technologies.map((hub) => (
            <a href={`/technology/${hub.slug}/`}>
              <>
                <strong>{hub.label}</strong>
                <span>{hub.organizationCount} organizations</span>
              </>
            </a>
          ))
        }
      </div>
      <p class="insights-note">
        Tags combine each organization’s latest three archived appearances and
        are normalized for spelling and capitalization. Organizations can list
        multiple technologies, so these counts overlap and do not describe
        year-by-year trends.
        <a href="/technologies/">Explore all technology directories</a>.
      </p>
    </section>

    <section class="hub-section" aria-labelledby="insights-method-heading">
      <div class="hub-section-heading">
        <h2 id="insights-method-heading">Sources and counting method</h2>
      </div>
      <p>
        These tables are calculated from the same version-controlled records
        used by the directory and refresh when those records change.
        Organizations with known name changes or a matching website are combined
        into one profile. Annual participation is counted once per profile; the
        distinct total counts each profile once across all years.
      </p>
      <p>
        Project totals use the counts reported in the snapshots, falling back to
        the number of available project records when a count is missing. Some
        snapshots contain a total without every project’s details. These figures
        describe the archive, not application volumes, acceptance rates, or
        future participation.
      </p>
      <ul>
        <li>
          <a href="https://summerofcode.withgoogle.com/archive"
            >Official Google Summer of Code archive</a
          >
        </li>
        <li>
          <a
            href="https://github.com/rohanmalhotracodes/GSoC-Organizations/tree/main/data/raw"
            >Source snapshots by year</a
          >
        </li>
        <li>
          <a
            href="https://github.com/rohanmalhotracodes/GSoC-Organizations/blob/main/scripts/prepare-data.mjs"
            >Organization normalization and data preparation</a
          >
        </li>
        <li><a href="/about/">About the data and its limitations</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
